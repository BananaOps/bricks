# Local development: a plain SQLite file, no account needed.
DATABASE_URL=file:./bricks.db

# Turso (production). The auth token may also be embedded in the URL.
# DATABASE_URL=libsql://<database>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Listen address, and the frontend origin allowed through CORS.
ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173
